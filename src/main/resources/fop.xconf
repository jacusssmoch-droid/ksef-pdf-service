<?xml version="1.0" encoding="UTF-8"?>
<fop version="2.8">
    <base>./</base>
    <source-resolution>96</source-resolution>
    <target-resolution>96</target-resolution>
    <default-page-settings height="29.7cm" width="21cm"/>
    <renderers>
        <renderer mime="application/pdf">
            <fonts>
                <font kerning="yes" embed-url="classpath:fonts/OpenSans-Regular.ttf">
                    <font-triplet name="sans" style="normal" weight="normal"/>
                </font>
                <font kerning="yes" embed-url="classpath:fonts/OpenSans-Bold.ttf">
                    <font-triplet name="sans" style="normal" weight="bold"/>
                </font>
            </fonts>
        </renderer>
    </renderers>
</fop>
